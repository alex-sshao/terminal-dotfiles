{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
		"type": "kitty-direct", 
		"source": "~/.config/mango/wallpaper/mango.png",
        "padding": {
            "top": 1,
        }
    },
    "display": {
        "separator": " -> ",
        "constants": [
            "──────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "type": "title",
            "key": "  ",
            "keyColor": "90",
            "keyWidth": 2
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├{icon}",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├{icon}",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": "│ └󰸉",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "│ └󰍹",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        "break"
    ]
}
